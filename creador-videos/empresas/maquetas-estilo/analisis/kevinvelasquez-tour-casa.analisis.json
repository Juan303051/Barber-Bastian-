 "voz": {
  "idioma": "es",
  "palabras_por_min": 65,
  "gancho_texto": "El verdadero lujo no siempre hace ruido. A veces se tiene que cruzar una puerta como esta.",
  "segmentos": [
   {
    "ini": 0.0,
    "fin": 2.6,
    "texto": "El verdadero lujo no siempre hace ruido."
   },
   {
    "ini": 3.0,
    "fin": 7.1,
    "texto": "A veces se tiene que cruzar una puerta como esta."
   },
   {
    "ini": 24.8,
    "fin": 27.9,
    "texto": "Cuatro habitaciones y espacio de sobra."
   },
   {
    "ini": 28.2,
    "fin": 32.5,
    "texto": "Alberca privada, gimnasio y todo sin salir de casa."
   },
   {
    "ini": 38.8,
    "fin": 40.2,
    "texto": "Despacio ni hablamos."
   },
   {
    "ini": 40.5,
    "fin": 43.8,
    "texto": "Esta casa se extiende prácticamente de punta a punta."
   },
   {
    "ini": 44.4,
    "fin": 46.8,
    "texto": "Y hasta la cocina es inteligente."
   },
   {
    "ini": 55.8,
    "fin": 60.4,
    "texto": "Y todo esto dentro de una de las comunidades más consolidadas de Playa del Carmen."
   },
   {
    "ini": 60.4,
    "fin": 65.8,
    "texto": "Cerca del mar, cerca del centro y rodeado de propiedades que mantienen el nivel."
   },
   {
    "ini": 66.1,
    "fin": 75.4,
    "texto": "Lo que le falta esta casa es que vengas a verlo."
   },
   {
    "ini": 76.2,
    "fin": 78.2,
    "texto": "Escríbeme y agendemos una cita."
   }
  ],
