   },
   {
    "ini": 41.0,
    "fin": 42.7,
    "texto": "Tiene necesidad de que las personas te paguen."
   },
   {
    "ini": 42.9,
    "fin": 44.4,
    "texto": "Una vez que ya tengas tus primeros clientes,"
   },
   {
    "ini": 44.6,
